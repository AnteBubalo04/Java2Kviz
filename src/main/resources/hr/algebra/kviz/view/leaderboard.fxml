<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.layout.VBox?>

<VBox xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="hr.algebra.kviz.controller.LeaderboardController" spacing="16" styleClass="page">
    <padding><Insets top="22" right="22" bottom="22" left="22"/></padding>

    <Label text="Ljestvica" styleClass="page-title"/>
    <TableView fx:id="leaderboardTable" VBox.vgrow="ALWAYS">
        <columnResizePolicy><TableView fx:constant="CONSTRAINED_RESIZE_POLICY"/></columnResizePolicy>
        <columns>
            <TableColumn fx:id="rankColumn" text="#" prefWidth="50" sortable="false"/>
            <TableColumn fx:id="playerColumn" text="Igrač" prefWidth="220"/>
            <TableColumn fx:id="scoreColumn" text="Bodovi" prefWidth="120"/>
            <TableColumn fx:id="correctColumn" text="Točni" prefWidth="110"/>
            <TableColumn fx:id="modeColumn" text="Način" prefWidth="110"/>
            <TableColumn fx:id="dateColumn" text="Datum" prefWidth="170"/>
        </columns>
    </TableView>
</VBox>
