<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.Separator?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>

<BorderPane xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="hr.algebra.kviz.controller.MainController" styleClass="root-pane">
    <left>
        <VBox styleClass="side-menu" spacing="6">
            <padding><Insets top="20" right="14" bottom="20" left="14"/></padding>
            <Label text="KVIZ" styleClass="logo"/>
            <Label text="Java 2 projekt" styleClass="logo-subtitle"/>
            <Separator/>
            <Button text="Nova igra" onAction="#onNewGame" styleClass="menu-button" maxWidth="Infinity"/>
            <Button text="Učitaj igru" onAction="#onLoadGame" styleClass="menu-button" maxWidth="Infinity"/>
            <Button text="Replay zadnje igre" onAction="#onReplay" styleClass="menu-button" maxWidth="Infinity"/>
            <Button text="Ljestvica" onAction="#onLeaderboard" styleClass="menu-button" maxWidth="Infinity"/>
            <Button text="Postavke" onAction="#onSettings" styleClass="menu-button" maxWidth="Infinity"/>
            <Button text="Dokumentacija" onAction="#onDocumentation" styleClass="menu-button" maxWidth="Infinity"/>
            <Region VBox.vgrow="ALWAYS"/>
            <Label text="Igrač" styleClass="menu-caption"/>
            <Label fx:id="playerLabel" styleClass="menu-player"/>
            <Button text="Izlaz" onAction="#onExit" styleClass="menu-button,exit-button" maxWidth="Infinity"/>
        </VBox>
    </left>
    <center>
        <StackPane fx:id="contentArea" styleClass="content-area"/>
    </center>
    <bottom>
        <HBox styleClass="status-bar">
            <padding><Insets top="6" right="14" bottom="6" left="14"/></padding>
            <Label fx:id="statusLabel"/>
            <Region HBox.hgrow="ALWAYS"/>
            <Label text="Ante Bubalo · Algebra"/>
        </HBox>
    </bottom>
</BorderPane>
