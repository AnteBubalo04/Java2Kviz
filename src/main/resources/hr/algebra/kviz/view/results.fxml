<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<VBox xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="hr.algebra.kviz.controller.ResultsController" spacing="16" styleClass="page">
    <padding><Insets top="22" right="22" bottom="22" left="22"/></padding>

    <Label fx:id="winnerLabel" styleClass="page-title"/>

    <HBox spacing="18">
        <VBox styleClass="score-card,big">
            <Label fx:id="localNameLabel" styleClass="score-name"/>
            <Label fx:id="localScoreLabel" styleClass="score-value"/>
            <Label fx:id="localCorrectLabel"/>
        </VBox>
        <VBox fx:id="opponentBox" styleClass="score-card,big,opponent">
            <Label fx:id="opponentNameLabel" styleClass="score-name"/>
            <Label fx:id="opponentScoreLabel" styleClass="score-value"/>
            <Label fx:id="opponentCorrectLabel"/>
        </VBox>
    </HBox>

    <TableView fx:id="detailsTable" VBox.vgrow="ALWAYS">
        <columnResizePolicy><TableView fx:constant="CONSTRAINED_RESIZE_POLICY"/></columnResizePolicy>
        <columns>
            <TableColumn fx:id="numberColumn" text="#" prefWidth="40"/>
            <TableColumn fx:id="questionColumn" text="Pitanje" prefWidth="330"/>
            <TableColumn fx:id="yourAnswerColumn" text="Tvoj odgovor" prefWidth="170"/>
            <TableColumn fx:id="opponentAnswerColumn" text="Protivnik" prefWidth="170"/>
            <TableColumn fx:id="correctColumn" text="Točan odgovor" prefWidth="170"/>
        </columns>
    </TableView>

    <HBox spacing="10">
        <Button text="Nova igra" onAction="#onNewGame" styleClass="primary-button"/>
        <Button text="Pogledaj replay" onAction="#onReplay" styleClass="secondary-button"/>
        <Button text="Ljestvica" onAction="#onLeaderboard" styleClass="secondary-button"/>
    </HBox>
</VBox>
